FROM debian:bullseye

ENV DEB_DIST_DIR=/dist
ENV BUILD_HOME=/home/build
ENV CASSANDRA_DIR=$BUILD_HOME/cassandra

LABEL org.cassandra.buildenv=bullseye

VOLUME ${DEB_DIST_DIR}

# bullseye reached end-of-life on 2026-08-31. archive.debian.org is a Fastly cache that
# returns 404 for individual .deb files from the Jenkins ARM builders, while the same URLs
# succeed elsewhere. Take main, updates, and security from one snapshot dated just after
# end-of-life. The base image already has those security versions installed, so without the
# security line apt cannot resolve libc6-dev, perl or gnupg2.
# The snapshot serves Release files past their Valid-Until, and it rate-limits, so apt retries.
# These must be https: plain http to them times out on the Instaclustr build network. The base
# image carries no ca-certificates, so peer verification is off; apt still authenticates the
# repositories through their GPG signatures via debian-archive-keyring.
# Upstream starting point: https://github.com/apache/cassandra-builds/commit/d0f23168add29f0c16e6ff157354f42485800f74
RUN echo 'deb https://snapshot.debian.org/archive/debian/20260901T000000Z bullseye main' > /etc/apt/sources.list \
 && echo 'deb https://snapshot.debian.org/archive/debian/20260901T000000Z bullseye-updates main' >> /etc/apt/sources.list \
 && echo 'deb https://snapshot.debian.org/archive/debian-security/20260901T000000Z bullseye-security main' >> /etc/apt/sources.list \
 && printf 'Acquire::Check-Valid-Until "false";\nAcquire::https::Verify-Peer "false";\nAcquire::Retries "5";\n' > /etc/apt/apt.conf.d/80no-check-valid-until

# install deps
RUN apt-get update && apt-get -y install \
   build-essential \
   curl \
   devscripts \
   git \
   wget \
   sudo

RUN apt-get -y --no-install-recommends install \
   openjdk-17-jdk \
   sphinx-doc \
   sphinx-common \
   sphinx-rtd-theme-common \
   debhelper

RUN update-java-alternatives --set java-1.17.0-openjdk-$(dpkg --print-architecture)

# install ant v1.10
# downloads.apache.org only carries current releases, so it 404s a pinned version as soon as a
# newer one ships. archive.apache.org keeps every release, so it stays valid.
# archive.apache.org is intermittently unreachable from the Jenkins builders, and wget gives up
# after one failed connection despite --tries, so retry in the shell.
RUN mkdir /usr/share/antV110 && \
    for attempt in 1 2 3 4 5; do \
        wget --timeout 60 -O apache-ant-1.10.17-bin.tar.gz \
            https://archive.apache.org/dist/ant/binaries/apache-ant-1.10.17-bin.tar.gz && break; \
        echo "ant download attempt ${attempt}/5 failed"; \
        if [ "${attempt}" -eq 5 ]; then exit 1; fi; \
        sleep 30; \
    done && \
    tar --strip-components 1 -xf apache-ant-1.10.17-bin.tar.gz -C /usr/share/antV110 && \
    rm -f apache-ant-1.10.17-bin.tar.gz
ENV ANT_HOME=/usr/share/antV110
ENV PATH="${ANT_HOME}/bin:${PATH}"


# create and change to build user
RUN adduser --disabled-login --gecos build build && gpasswd -a build sudo
RUN echo "build ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/build && \
   chmod 0440 /etc/sudoers.d/build

USER build

# clone Cassandra
ARG CASSANDRA_GIT_URL=https://gitbox.apache.org/repos/asf/cassandra.git
RUN git clone ${CASSANDRA_GIT_URL} ${CASSANDRA_DIR}
WORKDIR ${CASSANDRA_DIR}
